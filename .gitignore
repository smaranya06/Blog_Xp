# ==============================================================================
# Blog_Xp - Git Ignore Configuration
# ==============================================================================

# 1. Dependencies
node_modules/
jspm_packages/
web_modules/

# 2. Environment Variables & Secret Credentials
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.env
! .env.example

# 3. User Uploaded Content (Preserve directory structure via .gitkeep)
public/uploads/**
!public/uploads/**/
!public/uploads/**/.gitkeep

# 4. Logs & Debugging Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# 5. Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 6. IDE & Code Editor Files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# 7. Testing & Coverage Reports
coverage/
.nyc_output/

# 8. Temporary Files & Scratch Scripts
pids/
*.pid
*.seed
*.pid.lock
.tempmediaStorage/
scratch/
scratch_*.js
test_*.js